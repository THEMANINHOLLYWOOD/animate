# Copy to .env.local and fill in. Only ANTHROPIC_API_KEY is required to make films.

# Required: writes the treatment and the film (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Optional: the model every stage uses (default claude-fable-5-2)
ANTHROPIC_MODEL=
# Optional: only for organisation-level API keys, which must name a workspace
ANTHROPIC_WORKSPACE_ID=

# Optional: sound effects, voiceover, transcription (music needs a paid plan; https://elevenlabs.io)
ELEVENLABS_API_KEY=
# Optional: splits a recreated video's sound into speech, music and effects (https://fal.ai)
FAL_KEY=

# Optional: accounts and cloud storage. Without Clerk keys, everyone is a guest (films stay in
# the browser); in local development the app then runs as one owner with cloud storage.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
BLOB_READ_WRITE_TOKEN=

# Optional: shared rate limits (Upstash Redis). Without it, limits are kept per server instance.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional: multiply the shared guest / signed-in spending pools (2 = twice as big)
ANIMATE_GUEST_POOL_SCALE=
ANIMATE_USER_POOL_SCALE=

# Optional: the function time limit in seconds (default 285; set 780 on Vercel Pro) and a fixed
# effort for the animator (low | medium | high; default fits the time limit)
ANIMATE_FUNCTION_SECONDS=
ANIMATE_EFFORT=

# Optional: only for scripts/higgsfield (npm run higgsfield:example), as key-id:key-secret
HF_CREDENTIALS=
